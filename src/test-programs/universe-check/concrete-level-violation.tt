@test success
@name "Prop-valued inductive is impredicative over Type"

-- Regression: Prop-valued inductives now use the impredicative universe
-- check, so storing Type-level witnesses is allowed here. The non-Prop
-- oversized-constructor failure case lives in
-- `prop/prop-still-checks-positive-universes.tt`.

inductive BadList : Type -> Prop where
  BNil : {A : Type} -> BadList A
  BCons : {A : Type} -> A -> BadList A -> BadList A
