@test success
@name "proof irrelevance: two distinct constructors of a Prop-valued inductive are defeq"
@import preambles/equality-poly.tt

-- A proposition with two constructors. In a non-Prop universe they'd be
-- structurally distinct (think Bool's True vs False). In Prop they are
-- DEFINITIONALLY EQUAL by proof irrelevance.
inductive P : Prop where
  pa : P
  pb : P

-- The conversion check during refl-matching must collapse pa and pb.
-- Without proof irrelevance this would fail (`pa ≠ pb` structurally).
paEqPb : EqualProp pa pb
paEqPb = reflProp
