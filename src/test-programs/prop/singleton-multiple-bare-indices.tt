@test success
@name "singleton: two distinct args, both bare in distinct indices (Eq-style)"
@import preambles/nat.tt

-- Both `a` and `b` appear as bare-Var indices. This is the Eq-style
-- pattern but with two genuinely-distinct values. Each is uniquely
-- recoverable from its own index slot, so the inductive is singleton.
inductive TwoNats : Nat -> Nat -> Prop where
  pair : (a : Nat) -> (b : Nat) -> TwoNats a b

-- Both projections allowed by singleton elimination.
projA : (a : Nat) -> (b : Nat) -> TwoNats a b -> Nat
projA a b (pair x y) = x

projB : (a : Nat) -> (b : Nat) -> TwoNats a b -> Nat
projB a b (pair x y) = y
