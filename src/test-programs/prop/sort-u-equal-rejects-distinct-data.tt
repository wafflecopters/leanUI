@test failure
@name "Sort u Equal: STILL respects distinctness at Type level"
@error "conflict"
@import preambles/equality-sort.tt
@import preambles/nat.tt

-- Critical regression: proof irrelevance must NOT bleed across Type
-- when using a universe-polymorphic Equal. Equating Zero and Succ Zero
-- must fail even though Equal lives in Prop.
zeroEqSucc : Equal Zero (Succ Zero)
zeroEqSucc = refl
