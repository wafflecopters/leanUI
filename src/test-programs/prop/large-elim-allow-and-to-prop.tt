@test success
@name "small-elim: case-analysing And to produce a proof is allowed"

inductive P : Prop where pp : P
inductive Q : Prop where pq : Q

inductive And : Prop -> Prop -> Prop where
  intro : {A : Prop} -> {B : Prop} -> A -> B -> And A B

-- Projecting the left component out of And — the motive (P) lands in Prop,
-- so this is small elimination. Allowed even if And were not singleton.
andProjL : And P Q -> P
andProjL (intro a _) = a
