@test success
@name "(P : Prop) -> Type stays in Type 1 (imax(0, 2) = 2)"

inductive P : Prop where
  evP : P

-- Asymmetric: only the *codomain* being Prop forces the Pi into Prop.
-- The codomain here is the *term* `Type` which itself has type `Type 1`,
-- so the Pi lives at level imax(level(Prop), level(Type 1)) = imax(0, 2) = 2.
PiPropType : Type 1
PiPropType = P -> Type
