@test success
@name "PLift also lifts a Type (ULift use case)"
@import preambles/plift.tt
@import preambles/nat.tt

-- For Type-valued arguments, PLift behaves as ULift: it lifts the type
-- one universe level up. Single definition covers both Prop and Type.
wrappedNat : Type 1
wrappedNat = PLift Nat

wrappedZero : PLift Nat
wrappedZero = mkPLift Zero
