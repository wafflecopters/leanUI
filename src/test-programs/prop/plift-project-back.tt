@test success
@name "PLift is singleton-eliminable: project the wrapped value back"
@import preambles/plift.tt
@import preambles/nat.tt

-- PLift is in Type (always — by its signature), so large elimination is
-- unrestricted regardless of the wrapped sort. Projecting a Nat back out
-- of a PLift Nat is fine.
unliftNat : PLift Nat -> Nat
unliftNat (mkPLift n) = n
