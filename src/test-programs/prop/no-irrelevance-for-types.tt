@test failure
@name "no proof irrelevance for Type-valued inductives"
@error "conflict"
@import preambles/equal-simple.tt

-- Critical regression: proof irrelevance must NOT collapse distinct values
-- of a Type-valued inductive. Bool's True and False are structurally
-- different — equating them must fail.
inductive Bool : Type where
  TT : Bool
  FF : Bool

ttEqFf : Equal TT FF
ttEqFf = refl
