@test failure
@name "no proof irrelevance across different propositions"
@import preambles/equality-poly.tt

-- Proof irrelevance equates two proofs OF THE SAME proposition. A proof
-- of P and a proof of Q (P ≠ Q) cannot be equated even if both have type
-- in Prop — the witnesses live in different propositions. EqualProp's
-- implicit {P : Prop} parameter cannot unify both sides.
inductive P : Prop where
  pwitness : P

inductive Q : Prop where
  qwitness : Q

pEqQ : EqualProp pwitness qwitness
pEqQ = reflProp
